		<rect x="5" y="8" width="32" height="4" fill="#52525b" rx="1"/>
		<rect x="5" y="18" width="30" height="2.5" fill="#818cf8" rx="1"/>
		<rect x="5" y="24" width="26" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="5" y="30" width="28" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="5" y="36" width="24" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="5" y="42" width="30" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="5" y="48" width="22" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="50" y="10" width="100" height="5" fill="#52525b" rx="1"/>
		<rect x="50" y="20" width="90" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="50" y="26" width="95" height="2.5" fill="#3f3f46" rx="1"/>
		<rect x="50" y="36" width="100" height="20" fill="#09090b" rx="2"/>
		<rect x="55" y="41" width="50" height="2" fill="#818cf8" rx="1"/>
		<rect x="55" y="46" width="65" height="2" fill="#34d399" rx="1"/>
		<rect x="55" y="51" width="40" height="2" fill="#fbbf24" rx="1"/>
		<rect x="50" y="62" width="90" height="2.5" fill="#3f3f46" rx="1"/>
