package kbpages

import (
	"fmt"
	"github.com/frkn/doc-ui/internal/models"
	"github.com/frkn/doc-ui/templates/layouts"
)

templ KBDashboard(kb *models.KnowledgeBase, articles []models.Article, rawDocs []models.RawDocument, healthChecks []models.HealthCheck, progress *models.PipelineProgress, llmConfigured bool, projects []models.Project) {
	@layouts.Base(kb.Name) {
		<div class="fade-up">
			<div class="flex items-center gap-2 mb-1">
				<a href="/kb" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-300 transition-colors">&larr; Knowledge Bases</a>
			</div>
			<div class="flex items-center justify-between mb-8">
				<div>
					<h1 class="font-display font-bold text-2xl text-white tracking-tight">{ kb.Name }</h1>
					if kb.Description != "" {
						<p class="text-sm text-zinc-500 mt-1">{ kb.Description }</p>
					}
				</div>
				@kbStatusBadge(kb.Status)
			</div>
		</div>
		<!-- Stats Row -->
		<div class="grid grid-cols-4 gap-3 mb-8 fade-up fade-up-1">
			@statCard("Articles", fmt.Sprintf("%d", kb.ArticleCount), "indigo")
			@statCard("Raw Docs", fmt.Sprintf("%d", kb.RawCount), "amber")
			@statCard("Issues", fmt.Sprintf("%d", len(healthChecks)), "rose")
			@statCard("Status", kb.Status, "emerald")
		</div>
		<!-- Actions -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8 fade-up fade-up-2">
			<a href={ templ.SafeURL(fmt.Sprintf("/kb/%d/articles", kb.ID)) } class="border border-zinc-800 rounded-lg p-4 hover:border-indigo-500/50 hover:bg-indigo-500/5 transition-all text-center group">
				<i data-lucide="book-open" class="w-6 h-6 mx-auto mb-1 text-zinc-500 group-hover:text-indigo-400 transition-colors"></i>
				<div class="text-xs font-mono text-zinc-400 group-hover:text-indigo-400">Browse Wiki</div>
			</a>
			<a href={ templ.SafeURL(fmt.Sprintf("/kb/%d/chat", kb.ID)) } class="border border-zinc-800 rounded-lg p-4 hover:border-indigo-500/50 hover:bg-indigo-500/5 transition-all text-center group">
				<i data-lucide="message-circle" class="w-6 h-6 mx-auto mb-1 text-zinc-500 group-hover:text-indigo-400 transition-colors"></i>
				<div class="text-xs font-mono text-zinc-400 group-hover:text-indigo-400">Q&amp;A Chat</div>
			</a>
			<a href={ templ.SafeURL(fmt.Sprintf("/kb/%d/graph", kb.ID)) } class="border border-zinc-800 rounded-lg p-4 hover:border-indigo-500/50 hover:bg-indigo-500/5 transition-all text-center group">
				<i data-lucide="git-fork" class="w-6 h-6 mx-auto mb-1 text-zinc-500 group-hover:text-indigo-400 transition-colors"></i>
				<div class="text-xs font-mono text-zinc-400 group-hover:text-indigo-400">Concept Graph</div>
			</a>
			<a href={ templ.SafeURL(fmt.Sprintf("/kb/%d/health", kb.ID)) } class="border border-zinc-800 rounded-lg p-4 hover:border-indigo-500/50 hover:bg-indigo-500/5 transition-all text-center group">
				<i data-lucide="shield-check" class="w-6 h-6 mx-auto mb-1 text-zinc-500 group-hover:text-indigo-400 transition-colors"></i>
				<div class="text-xs font-mono text-zinc-400 group-hover:text-indigo-400">Health Check</div>
			</a>
		</div>
		<!-- Upload + Compile -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 fade-up fade-up-3">
			<!-- Upload Raw Documents -->
			<div class="window-card">
				<div class="window-bar">
					<div class="window-dot" style="background: #ff5f57;"></div>
					<div class="window-dot" style="background: #febc2e;"></div>
					<div class="window-dot" style="background: #28c840;"></div>
					<span class="ml-2 text-xs font-mono text-zinc-500">upload-raw</span>
				</div>
				<div class="window-body">
					<h3 class="font-display font-semibold text-white mb-3">Upload Source Documents</h3>
					<form
						hx-post={ fmt.Sprintf("/kb/%d/raw/upload", kb.ID) }
						hx-target="#raw-doc-list"
						hx-swap="innerHTML"
						hx-encoding="multipart/form-data"
						class="space-y-3"
					>
						<input
							type="file"
							name="file"
							required
							accept=".md,.txt,.html,.htm,.json,.csv,.pdf"
							class="w-full text-sm text-zinc-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-zinc-800 file:text-zinc-300 hover:file:bg-zinc-700 file:cursor-pointer"
						/>
						<button type="submit" class="w-full px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-mono rounded-lg transition-colors">
							Upload &rarr;
						</button>
					</form>
					<!-- Import from crawled project -->
					if len(projects) > 0 {
						<div class="mt-4 pt-4 border-t border-zinc-800">
							<label class="block text-[10px] font-mono text-zinc-400 mb-2 uppercase tracking-[0.15em]">Import from Crawled Docs</label>
							<form
								hx-post={ fmt.Sprintf("/kb/%d/raw/import-project", kb.ID) }
								hx-target="#raw-doc-list"
								hx-swap="innerHTML"
								class="flex gap-2"
							>
								<select
									name="project_id"
									required
									class="flex-1 px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-white text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/30 transition-all"
								>
									<option value="" disabled selected>Select a project...</option>
									for _, p := range projects {
										if p.Status == "done" && p.PageCount > 0 {
											<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ fmt.Sprintf("%d pages", p.PageCount) })</option>
										}
									}
								</select>
								<button type="submit" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-mono rounded-lg transition-colors flex-shrink-0">
									Import
								</button>
							</form>
						</div>
					}
					<div id="raw-doc-list" class="mt-4 space-y-1 max-h-40 overflow-y-auto">
						@RawDocItems(kb, rawDocs)
					</div>
				</div>
			</div>
			<!-- Compile Wiki -->
			<div class="window-card">
				<div class="window-bar">
					<div class="window-dot" style="background: #ff5f57;"></div>
					<div class="window-dot" style="background: #febc2e;"></div>
					<div class="window-dot" style="background: #28c840;"></div>
					<span class="ml-2 text-xs font-mono text-zinc-500">compile-wiki</span>
				</div>
				<div class="window-body">
					<h3 class="font-display font-semibold text-white mb-3">Wiki Compiler</h3>
					<p class="text-xs text-zinc-500 mb-4">The LLM will process raw documents, extract concepts, and generate wiki articles.</p>
					<div id="compile-area">
						if progress != nil {
							@CompileProgress(kb.ID, progress)
						} else {
							<div class="space-y-3">
								if llmConfigured {
									<button
										hx-post={ fmt.Sprintf("/kb/%d/compile", kb.ID) }
										hx-target="#compile-area"
										hx-swap="innerHTML"
										class="w-full px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg transition-colors"
									>
										Compile Wiki &rarr;
									</button>
								} else {
									<div class="text-xs text-amber-400 bg-amber-950/30 border border-amber-900/50 rounded px-3 py-2 font-mono">
										Configure LLM_PROVIDER + LLM_API_KEY to enable
									</div>
								}
								<button
									hx-post={ fmt.Sprintf("/kb/%d/sync", kb.ID) }
									hx-target="#sync-result"
									hx-swap="innerHTML"
									class="w-full px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-mono rounded-lg transition-colors"
								>
									Sync from Disk
								</button>
								<div id="sync-result"></div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
		<!-- Recent Articles -->
		if len(articles) > 0 {
			<div class="fade-up">
				<h3 class="font-display font-semibold text-white mb-3">Recent Articles</h3>
				<div class="space-y-1">
					for _, a := range articles {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/kb/%d/articles/%s", kb.ID, trimMD(a.FilePath))) }
							class="block px-3 py-2 rounded-lg border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900/50 transition-all"
						>
							<div class="flex items-center justify-between">
								<span class="text-sm text-zinc-300">{ a.Title }</span>
								<div class="flex items-center gap-2 text-[10px] font-mono text-zinc-600">
									if a.Category != "" {
										<span class="bg-zinc-800 px-1.5 py-0.5 rounded">{ a.Category }</span>
									}
									<span>{ fmt.Sprintf("%d words", a.WordCount) }</span>
								</div>
							</div>
						</a>
					}
				</div>
			</div>
		}
	}
}

templ statCard(label, value, color string) {
	<div class="border border-zinc-800 rounded-lg p-3 bg-zinc-900/50">
		<div class={ fmt.Sprintf("text-xl font-display font-bold text-%s-400", color) }>{ value }</div>
		<div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mt-0.5">{ label }</div>
	</div>
}

templ CompileProgress(kbID int64, progress *models.PipelineProgress) {
	<div
		hx-get={ fmt.Sprintf("/kb/%d/compile/progress", kbID) }
		hx-trigger="every 2s"
		hx-swap="outerHTML"
	>
		<div class="flex items-center justify-between mb-2">
			<div class="flex items-center gap-2">
				<div class="animate-spin h-3 w-3 border-[1.5px] border-indigo-400 border-t-transparent rounded-full"></div>
				<span class="text-xs text-indigo-400 font-mono">{ progress.Stage }</span>
			</div>
			<button
				hx-post={ fmt.Sprintf("/kb/%d/compile/stop", kbID) }
				hx-swap="none"
				class="text-[10px] font-mono text-zinc-500 hover:text-red-400 transition-colors px-2 py-0.5 border border-zinc-700 hover:border-red-400/50 rounded"
			>
				stop
			</button>
		</div>
		if progress.Total > 0 {
			<div class="w-full bg-zinc-800 rounded-full h-1.5 mb-1">
				@templ.Raw(fmt.Sprintf(`<div class="bg-indigo-500 h-1.5 rounded-full transition-all" style="width:%d%%"></div>`, progressPercent(progress.Processed, progress.Total)))
			</div>
			<div class="text-[10px] font-mono text-zinc-600">
				{ fmt.Sprintf("%d / %d", progress.Processed, progress.Total) }
				if progress.CurrentFile != "" {
					<span class="text-zinc-700"> &middot; </span>
					{ progress.CurrentFile }
				}
			</div>
		}
		if progress.ErrorMsg != "" {
			<div class="text-xs text-red-400 bg-red-950/30 border border-red-900/50 rounded px-3 py-2 font-mono mt-2">
				{ progress.ErrorMsg }
			</div>
		}
	</div>
}

templ CompileDone(kb *models.KnowledgeBase) {
	<div class="space-y-3">
		<div class="flex items-center gap-2 text-emerald-400 text-xs font-mono">
			<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
			Compilation complete
		</div>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/kb/%d/articles", kb.ID)) }
			class="block w-full px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg transition-colors text-center"
		>
			Browse Wiki &rarr;
		</a>
	</div>
}

templ RawDocItems(kb *models.KnowledgeBase, docs []models.RawDocument) {
	if len(docs) == 0 {
		<p class="text-xs text-zinc-600 font-mono">No documents uploaded yet</p>
	}
	for _, d := range docs {
		<div class="flex items-center justify-between px-2 py-1.5 rounded bg-zinc-900/50">
			<div class="flex items-center gap-2 min-w-0">
				if d.Processed {
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 flex-shrink-0"></span>
				} else {
					<span class="w-1.5 h-1.5 rounded-full bg-zinc-600 flex-shrink-0"></span>
				}
				<span class="text-xs text-zinc-400 truncate">{ d.FileName }</span>
			</div>
			<span class="text-[10px] font-mono text-zinc-600 flex-shrink-0">{ formatBytes(d.Size) }</span>
		</div>
	}
}

func progressPercent(processed, total int) int {
	if total == 0 {
		return 0
	}
	p := (processed * 100) / total
	if p > 100 {
		return 100
	}
	return p
}

func formatBytes(b int64) string {
	if b < 1024 {
		return fmt.Sprintf("%d B", b)
	}
	if b < 1024*1024 {
		return fmt.Sprintf("%.1f KB", float64(b)/1024)
	}
	return fmt.Sprintf("%.1f MB", float64(b)/(1024*1024))
}

func trimMD(s string) string {
	if len(s) > 3 && s[len(s)-3:] == ".md" {
		return s[:len(s)-3]
	}
	return s
}
