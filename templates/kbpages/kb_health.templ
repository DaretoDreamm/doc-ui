package kbpages

import (
	"fmt"
	"github.com/frkn/doc-ui/internal/models"
	"github.com/frkn/doc-ui/templates/layouts"
)

templ KBHealth(kb *models.KnowledgeBase, checks []models.HealthCheck, llmConfigured bool) {
	@layouts.Base(kb.Name + " - Health") {
		<div class="fade-up">
			<div class="flex items-center gap-2 mb-1">
				<a href={ templ.SafeURL(fmt.Sprintf("/kb/%d", kb.ID)) } class="text-[10px] font-mono text-zinc-500 hover:text-zinc-300 transition-colors">&larr; { kb.Name }</a>
			</div>
			<div class="flex items-center justify-between mb-6">
				<h1 class="font-display font-bold text-2xl text-white tracking-tight">Health Check</h1>
				<button
					hx-post={ fmt.Sprintf("/kb/%d/health/run", kb.ID) }
					hx-target="#health-results"
					hx-swap="innerHTML"
					class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg transition-colors"
				>
					Run Health Check
				</button>
			</div>
		</div>
		<div id="health-results" class="fade-up fade-up-1">
			@HealthCheckResults(checks)
		</div>
	}
}

templ HealthCheckResults(checks []models.HealthCheck) {
	if len(checks) == 0 {
		<div class="text-center py-16 border border-dashed border-zinc-800 rounded-lg">
			<i data-lucide="circle-check" class="w-8 h-8 mx-auto mb-3 text-emerald-400"></i>
			<p class="text-sm text-zinc-500 font-mono">No issues found</p>
			<p class="text-xs text-zinc-600 mt-1">Your wiki looks healthy!</p>
		</div>
	} else {
		<div class="space-y-2">
			for _, c := range checks {
				@healthCheckCard(c)
			}
		</div>
		<div class="mt-4 text-xs text-zinc-600 font-mono">
			{ fmt.Sprintf("%d issue(s) found", len(checks)) }
		</div>
	}
}

templ healthCheckCard(c models.HealthCheck) {
	<div id={ fmt.Sprintf("health-%d", c.ID) } class="border rounded-lg p-4 flex items-start gap-3" style={ healthBorderColor(c.Severity) }>
		<div class="flex-shrink-0 mt-0.5">
			@healthIcon(c.Severity)
		</div>
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2 mb-1">
				<span class={ fmt.Sprintf("text-[10px] font-mono uppercase tracking-wider %s", healthTextColor(c.Severity)) }>{ c.Type }</span>
				<span class={ fmt.Sprintf("text-[10px] font-mono px-1.5 py-0.5 rounded %s", healthBadgeColor(c.Severity)) }>{ c.Severity }</span>
			</div>
			<p class="text-sm text-zinc-300">{ c.Message }</p>
		</div>
		<button
			hx-post={ fmt.Sprintf("/kb/%d/health/%d/resolve", c.KBID, c.ID) }
			hx-target={ fmt.Sprintf("#health-%d", c.ID) }
			hx-swap="outerHTML"
			class="flex-shrink-0 text-[10px] font-mono text-zinc-600 hover:text-zinc-300 px-2 py-1 border border-zinc-800 hover:border-zinc-600 rounded transition-colors"
		>
			dismiss
		</button>
	</div>
}

templ healthIcon(severity string) {
	switch severity {
		case "error":
			<span class="text-red-400 text-sm">●</span>
		case "warning":
			<span class="text-amber-400 text-sm">●</span>
		default:
			<span class="text-blue-400 text-sm">●</span>
	}
}

func healthBorderColor(severity string) string {
	switch severity {
	case "error":
		return "border-color: #7f1d1d;"
	case "warning":
		return "border-color: #78350f;"
	default:
		return "border-color: #27272a;"
	}
}

func healthTextColor(severity string) string {
	switch severity {
	case "error":
		return "text-red-400"
	case "warning":
		return "text-amber-400"
	default:
		return "text-blue-400"
	}
}

func healthBadgeColor(severity string) string {
	switch severity {
	case "error":
		return "bg-red-950/50 text-red-400"
	case "warning":
		return "bg-amber-950/50 text-amber-400"
	default:
		return "bg-blue-950/50 text-blue-400"
	}
}
