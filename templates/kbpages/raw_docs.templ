package kbpages

import (
	"fmt"
	"github.com/frkn/doc-ui/internal/models"
	"github.com/frkn/doc-ui/templates/layouts"
)

templ RawDocList(kb *models.KnowledgeBase, docs []models.RawDocument) {
	@layouts.Base(kb.Name + " - Raw Documents") {
		<div class="fade-up">
			<div class="flex items-center gap-2 mb-1">
				<a href={ templ.SafeURL(fmt.Sprintf("/kb/%d", kb.ID)) } class="text-[10px] font-mono text-zinc-500 hover:text-zinc-300 transition-colors">&larr; { kb.Name }</a>
			</div>
			<div class="flex items-center justify-between mb-6">
				<div>
					<h1 class="font-display font-bold text-2xl text-white tracking-tight">Raw Documents</h1>
					<p class="text-sm text-zinc-500 mt-1">Source materials ingested into the knowledge base</p>
				</div>
				<span class="text-[10px] font-mono text-zinc-500 bg-zinc-800 px-2 py-0.5 rounded">{ fmt.Sprintf("%d", len(docs)) }</span>
			</div>
		</div>
		<!-- Upload form -->
		<div class="window-card fade-up fade-up-1 mb-8">
			<div class="window-bar">
				<div class="window-dot" style="background: #ff5f57;"></div>
				<div class="window-dot" style="background: #febc2e;"></div>
				<div class="window-dot" style="background: #28c840;"></div>
				<span class="ml-2 text-xs font-mono text-zinc-500">upload</span>
			</div>
			<div class="window-body">
				<form
					hx-post={ fmt.Sprintf("/kb/%d/raw/upload", kb.ID) }
					hx-target="#raw-items"
					hx-swap="innerHTML"
					hx-encoding="multipart/form-data"
					class="flex items-center gap-4"
				>
					<input
						type="file"
						name="file"
						required
						accept=".md,.txt,.html,.htm,.json,.csv,.pdf"
						class="flex-1 text-sm text-zinc-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-zinc-800 file:text-zinc-300 hover:file:bg-zinc-700 file:cursor-pointer"
					/>
					<button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg transition-colors">
						Upload
					</button>
				</form>
			</div>
		</div>
		<!-- Document list -->
		<div id="raw-items" class="space-y-2 fade-up fade-up-2">
			@RawDocItems(kb, docs)
		</div>
	}
}
