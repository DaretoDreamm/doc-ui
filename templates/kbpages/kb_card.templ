package kbpages

import (
	"fmt"
	"github.com/frkn/doc-ui/internal/models"
)

func getKBPaletteColor(id string) string {
	for _, p := range models.ColorPalettes {
		if p.ID == id {
			return p.Color
		}
	}
	return "#0ea5e9"
}

templ KBCard(kb models.KnowledgeBase) {
	<div id={ fmt.Sprintf("kb-%d", kb.ID) } class="fade-up group border border-zinc-800 rounded-lg p-4 hover:border-zinc-700 transition-colors bg-zinc-900/50">
		<div class="flex items-start justify-between">
			<div class="flex items-start gap-3 flex-1 min-w-0">
				@templ.Raw(fmt.Sprintf(`<div class="w-9 h-9 rounded-md flex-shrink-0 flex items-center justify-center text-white font-display font-bold text-sm" style="background-color:%s">%s</div>`, getKBPaletteColor(kb.ColorPalette), string([]rune(kb.Name)[0:1])))
				<div class="min-w-0">
					<h3 class="font-display font-semibold text-white truncate text-[15px]">{ kb.Name }</h3>
					if kb.Description != "" {
						<p class="text-[11px] text-zinc-500 mt-0.5 truncate">{ kb.Description }</p>
					}
				</div>
			</div>
			<div class="flex items-center gap-2 ml-4 flex-shrink-0">
				@kbStatusBadge(kb.Status)
				<button
					hx-delete={ fmt.Sprintf("/kb/%d", kb.ID) }
					hx-target={ fmt.Sprintf("#kb-%d", kb.ID) }
					hx-swap="outerHTML"
					hx-confirm="Delete this knowledge base?"
					class="text-zinc-600 hover:text-red-400 transition-colors p-1 opacity-0 group-hover:opacity-100"
				>
					<i data-lucide="x" class="w-3.5 h-3.5"></i>
				</button>
			</div>
		</div>
		<div class="mt-3 pt-3 border-t border-zinc-800 flex items-center justify-between">
			<div class="flex items-center gap-2 text-[10px] font-mono text-zinc-500 uppercase tracking-wider">
				<span>{ fmt.Sprintf("%d articles", kb.ArticleCount) }</span>
				<span class="text-zinc-700">&middot;</span>
				<span>{ fmt.Sprintf("%d raw docs", kb.RawCount) }</span>
			</div>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/kb/%d", kb.ID)) }
				class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors"
			>
				Open
				<i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
			</a>
		</div>
	</div>
}

templ kbStatusBadge(status string) {
	switch status {
		case "compiling":
			<span class="flex items-center gap-1 text-[10px] font-mono text-indigo-400"><span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>compiling</span>
		case "active":
			<span class="flex items-center gap-1 text-[10px] font-mono text-emerald-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>active</span>
		default:
			<span class="flex items-center gap-1 text-[10px] font-mono text-zinc-500"><span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>idle</span>
	}
}
